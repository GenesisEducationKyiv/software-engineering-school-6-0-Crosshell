# App
NODE_ENV=development
APP_PORT=3000
GRPC_PORT=50051
APP_URL=http://localhost:3000

API_KEY=# Static API key for X-API-Key header authentication
        # If not set, all endpoints are publicly accessible (HTTP only)

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=

# RabbitMQ
RABBITMQ_URL=

# GitHub API (optional - increases rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=
# GitHub cache TTL in seconds (default: 600)
GITHUB_CACHE_TTL_SECONDS=

# Scanner cron schedule (default: every 10 minutes)
SCANNER_CRON="*/10 * * * *"

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
