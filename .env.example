# App
NODE_ENV=development
APP_PORT=3000
GRPC_PORT=50051
APP_URL=http://localhost:3000

# Notifier worker (health/metrics port)
NOTIFIER_WORKER_PORT=3002
# Notifier worker's SagaMailService gRPC port (internal-only, not published to the host)
SAGA_GRPC_PORT=50052

# How the API service's saga orchestrator sends the confirmation email:
# "queue" (default, via RabbitMQ command/reply) or "grpc" (direct call to the
# notifier's SagaMailService below)
SAGA_MAIL_TRANSPORT=queue
# Where the API service reaches the notifier's SagaMailService when SAGA_MAIL_TRANSPORT=grpc
SAGA_GRPC_URL=localhost:50052
SAGA_GRPC_DEADLINE_MS=10000

API_KEY=# Static API key for X-API-Key header authentication
        # If not set, all endpoints are publicly accessible (HTTP only)

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=

# RabbitMQ
RABBITMQ_URL=

# GitHub API (optional - increases rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=
# GitHub cache TTL in seconds (default: 600)
GITHUB_CACHE_TTL_SECONDS=

# Scanner cron schedule (default: every 10 minutes)
SCANNER_CRON="*/10 * * * *"

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Elasticsearch (optional — if not set, logs go to stdout only)
ELASTICSEARCH_URL=
# Password for the Elasticsearch built-in "elastic" user (docker-compose.prod.yml only)
ELASTIC_PASSWORD=

# Grafana admin password
GF_ADMIN_PASSWORD=
