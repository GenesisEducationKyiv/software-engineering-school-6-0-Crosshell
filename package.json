{
  "name": "github-release-notifier",
  "version": "1.0.0",
  "description": "github-release-notifier api",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "dev:notifier": "npx tsx watch src/notifier/index.ts",
    "build": "tsup src/index.ts src/notifier/index.ts --format cjs --no-splitting",
    "build:notifier": "tsup src/notifier/index.ts --format cjs --no-splitting --out-dir dist/notifier",
    "start": "node dist/index.js",
    "start:notifier": "node dist/notifier/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "proto:lint": "buf lint",
    "proto:generate": "buf generate",
    "bench:queue": "tsx scripts/bench-queue-transport.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:unit:run": "vitest run",
    "test:integration:up": "docker compose -f docker-compose.integration.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.integration.yml down",
    "test:integration": "npm run test:integration:up && vitest run --config vitest.integration.config.ts; EXIT=$?; npm run test:integration:down; exit $EXIT",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait --build",
    "test:e2e:down": "docker compose -f docker-compose.e2e.yml down",
    "test:e2e": "npm run test:e2e:up && playwright test; EXIT=$?; npm run test:e2e:down; exit $EXIT",
    "test:all": "npm run test:unit:run && npm run test:integration && npm run test:e2e",
    "test:e2e:run": "playwright test"
  },
  "keywords": [],
  "author": "Vladyslav Berdychevskyi",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.1",
    "@grpc/grpc-js": "^1.14.3",
    "amqplib": "^1.0.3",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-elasticsearch": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/eslint-plugin": "^1.6.16",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "msw": "^2.13.2",
    "prettier": "3.8.1",
    "ts-proto": "^2.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4",
    "vitest-mock-extended": "^4.0.0"
  }
}
